pragma solidity 0.8.28;

import {Script, console} from "forge-std/Script.sol";
import {PredicateFactory} from "../src/PredicateFactory.sol";
import {PredicateRouter} from "../src/PredicateRouter.sol";
import {PredicateTransferHook} from "../src/PredicateTransferHook.sol";

contract PredicateDeploymentScript is Script {
    PredicateFactory public factory;
    PredicateRouter public router;
    PredicateTransferHook public hook;

    function setUp() public {}

    function run() public {
        vm.startBroadcast();

        // Deploy the factory
        factory = new PredicateFactory(msg.sender);
        
        console.log("PredicateFactory deployed to:", address(factory));

        // Note: To deploy router and hook, you need to provide:
        // - gateway: Centrifuge Gateway contract address
        // - spoke: Centrifuge Spoke contract address  
        // - predicateManager: ServiceManager contract address
        // - policyID: Policy ID string
        // - redeemSource, depositTarget, crosschainSource: Relevant addresses
        // - root: Centrifuge Root contract address
        
        // Example (commented out - uncomment and provide real addresses):
        /*
        (router, hook) = factory.deployPredicateIntegration(
            IGateway(0x...), // gateway
            ISpoke(0x...),   // spoke
            0x...,           // predicateManager
            "policy-id-123", // policyID
            0x...,           // redeemSource
            0x...,           // depositTarget
            0x...,           // crosschainSource
            0x...            // root
        );
        
        console.log("PredicateRouter deployed to:", address(router));
        console.log("PredicateTransferHook deployed to:", address(hook));
        */

        vm.stopBroadcast();
    }
}
